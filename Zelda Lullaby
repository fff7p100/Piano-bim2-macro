import os
import time

SHEETS = """
u | 8 e I |
8 w u | 8 e I [8a] w u | d [8p] e I |op [8a] w u | d [8p] e I |
[a7] y o | d [^j] T o | h [6d] t o |sa [9p] t I |
[8a] w u | d [8p] e I |op [8a] w u | d [8p] e I |
[a7] y o | d [^j] T o | h [6z] t o | 9 t I [qz] t u | lk [0l] [rk] [yh] |
[9l] e t | kj [8k] [wj] [rf] |
[qz] t u | lk [0l] [rk] [yh] | l [(v] E T | 9etips wyah [8a] w u | d [8p] e I |op [8a] w u | d [8p] e I |
[a7] y o | d [^j] T o | h [6d] t o |s a [9p] t I o [wh]
"""


time.sleep(0)


TEMPO = 0.30

def send_note(key):
    if key.isupper() or key in '!@#$%^&*()_':
        os.system(f"xdotool key Shift+{key.lower()}")
    else:
        os.system(f"xdotool key {key}")

i = 0
length = len(SHEETS)

while i < length:
    char = SHEETS[i]
    
    
    if char == '[':
        chord = ""
        i += 1
        while i < length and SHEETS[i] != ']':
            chord += SHEETS[i]
            i += 1
        
        for note in chord:
            send_note(note)
        time.sleep(TEMPO)

    
    elif char in [' ', '|', '\n', '\r']:
        pass

    
    else:
        send_note(char)
        time.sleep(TEMPO)
        
    i += 1
