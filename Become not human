import os
import time

SHEETS = """
[yia]......
[yip]...
[9yis], [yia], [8tup]......
[tuo]......
[yip]......
[yio]...
[yis], [yia],
[tua]......
[tuo]
"""

time.sleep(0)

TEMPO = 0.32

def send_note(key):
    if key.isupper() or key in '!@#$%^&*()_':
        os.system(f"xdotool key Shift+{key.lower()}")
    else:
        os.system(f"xdotool key {key}")

i = 0
length = len(SHEETS)

while i < length:
    char = SHEETS[i]
    
    if char == '[':
        chord = ""
        i += 1
        while i < length and SHEETS[i] != ']':
            chord += SHEETS[i]
            i += 1
        
        for note in chord:
            send_note(note)
        time.sleep(TEMPO)

    elif char in [' ', '|', '\n', '\r']:
        pass

    else:
        send_note(char)
        time.sleep(TEMPO)
        
    i += 1
