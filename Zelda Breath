import os
import time

SHEETS = """
u i u Y u s [7a] [ryi] [ryi]
0 u [Wry] i u Y [Wryu] a [6p] [etu] [etu]
6 p [Tuo] a p O [Tuop] [fh] [9dg] [eyi] [dg] [eyidg]
[wdg] [ryifh] [ryidg] [8dg] [wtusf] [wtu]
8 [wtu] s [wtud] f [^sf] [Eyi] [Pd] [EPyid]
^ [Eyi] d [^f] d [6ad] [etu] [ps] [etups]
5 [etu] [etup] a [qps] [eti] d [etips]
[O0rua] f s [6p] 0 8
6 u i u Y u s [7a] [ryi] [ryi]
0 u [Wry] i u Y [Wryu] a [6p] [etu] [etu]
6 p [Tuo] a p O [Tuop] [fh] [9dg] [eyi] [dg] [eyidg]
[wdg] [ryifh] [ryidg] [8dg] [wtusf] [wtu]
8 [wtu] s [wtud] f [^sf] [Eyi] [Pd] [EPyid]
^ [Eyi] d [^f] d [6ad] [etu] [ps] [etups]
5 [etu] [etup] a [qps] [eti] d [etips]
[O0rua] f s [6p] 0 8
6 u i u Y u s [7a]
"""

time.sleep(0)

TEMPO = 0.30

def send_note(key):
    if key.isupper() or key in '!@#$%^&*()_':
        os.system(f"xdotool key Shift+{key.lower()}")
    else:
        os.system(f"xdotool key {key}")

i = 0
length = len(SHEETS)

while i < length:
    char = SHEETS[i]
    
    if char == '[':
        chord = ""
        i += 1
        while i < length and SHEETS[i] != ']':
            chord += SHEETS[i]
            i += 1
        
        for note in chord:
            send_note(note)
        time.sleep(TEMPO)

    elif char in [' ', '|', '\n', '\r']:
        pass

    else:
        send_note(char)
        time.sleep(TEMPO)
        
    i += 1
